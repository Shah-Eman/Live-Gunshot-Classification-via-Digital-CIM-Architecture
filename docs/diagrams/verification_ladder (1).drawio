ry x="1020" y="469" width="30" height="6" as="geometry"/></mxCell><mxCell id="c48" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D4F;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="92" y="450" width="44" height="44" as="geometry"/></mxCell><mxCell id="c49" value="Post-synthesis" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="152" y="416" width="500" height="24" as="geometry"/></mxCell><mxCell id="c50" value="Step 1.9  |  Vivado (hierarchical reports)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;fontSize=12;fontColor=#2E7D4F;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="420" width="550" height="20" as="geometry"/></mxCell><mxCell id="c51" value="Compare: Synthesized netlist (make synth BOARD=nexys, 100 MHz)  vs  reference" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="441" width="850" height="21" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Post-synthesis functional simulation bit-exact on 5 inputs" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="465" width="850" height="21" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;DSP = 0 inside the tile array; requantization DSPs reported separately with the whole-design total" style="text;html=1;whiteSpace=nowrap;align=