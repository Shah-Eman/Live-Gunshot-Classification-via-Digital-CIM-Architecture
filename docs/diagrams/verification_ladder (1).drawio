xCell><mxCell id="c22" value="Compare: ref_int.py  vs  quantized model, and vs an independent layer-1 implementation" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="873" width="850" height="21" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;No floats in the forward pass (dtype asserts); worst-case accumulator below the int32 bound" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="897" width="850" height="21" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Independent layer 1 matches on 100 random inputs; one hand-computed output matches trace()" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="917" width="850" height="21" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;ref_int accuracy equals the quantized-model accuracy" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="937" width="850" height="21" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=8;fillColor=#DCE9F8;strokeColor=#2F5F9E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="80" y="696" width="940" height="128" as="geometry"/></mxCell><mxCell id="c27" value="" style="fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="757" width="30" height="6" as="geometry"/></mxCell><mxCell id="c28" value="" style="fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1020" y="757" width="30" height="6" as="geometry"/></mxCell><mxCell id="c29" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2F5F9E;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="92" y="738" width="44" height="44" as="geometry"/></mxCell><mxCell id="c30" value="Python tile model (tile_model.py)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="152" y="704" width="500" height="24" as="geometry"/></mxCell><mxCell id="c31" value="Step 1.4  |  Python (sw/ref)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;fontSize=12;fontColor=#2F5F9E;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="708" width="550" height="20" as="geometry"/></mxCell><mxCell id="c32" value="Compare: Cycle-level 16x16 bit-serial tile model  vs  numpy W.T @ a" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="729" width="850" height="21" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;100% match on 100,000 random vectors" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="753" width="850" height="21" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;100% match on edge cases: all a = -128,