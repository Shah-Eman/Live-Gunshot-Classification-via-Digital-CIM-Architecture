lColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="276" width="550" height="20" as="geometry"/></mxCell><mxCell id="c61" value="Compare: Placed-and-routed design with timing  vs  reference" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="297" width="850" height="21" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Post-route timing simulation bit-exact on 20 clips (at least the largest CIM and baseline configs)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="321" width="850" height="21" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;WNS &amp;gt;= 0 at the target clock, or achieved frequency recorded" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="341" width="850" height="21" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=1;arcSize=8;fillColor=#FBEAD0;strokeColor=#B26A00;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="940" height="128" as="geometry"/></mxCell><mxCell id="c65" value="" style="fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="181" width="30" height="6" as="geometry"/></mxCell><mxCell id="c66" value="" style="fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1020" y="181" width="30" height="6" as="geometry"/></mxCell><mxCell id="c67" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B26A00;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="92" y="162" width="44" height="44" as="geometry"/></mxCell><mxCell id="c68" value="Board" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="152" y="128" width="500" height="24" as="geometry"/></mxCell><mxCell id="c69" value="Steps 1.10, 1.11, 4.2  |  Nexys A7-100T, then ZCU104" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;fontSize=12;fontColor=#B26A00;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="456" y="132" width="550" height="20" as="geometry"/></mxCell><mxCell id="c70" value="Compare: Bitstream on the board via the host link + host script  vs  ref_int.py" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="153" width="850" height="21" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Layer 1: every position and channel matches on every input; board cycles equal simulation cycles" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="177" width="850" height="21" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Full test set: 100% logit match with ref_int.py, for both CIM and baseline engines" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="197" width="850" height="21" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;PASS&lt;/b&gt;&amp;nbsp;&amp;nbsp;ZCU104 cycle count equals the Nexys cycle count exactly (cycles come from the design, not the board)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="152" y="217" width="850" height="21" as="geometry"/></mxCell><mxCell id="c74" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="970" width="18" height="11" as="geometry"/></mxCell><mxCell id="c75" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="826" width="18" height="11" as="geometry"/></mxCell><mxCell id="c76" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="682" width="18" height="11" as="geometry"/></mxCell><mxCell id="c77" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="538" width="18" height="11" as="geometry"/></mxCell><mxCell id="c78" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="394" width="18" height="11" as="geometry"/></mxCell><mxCell id="c79" value="" style="triangle;direction=north;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="541" y="250" width="18" height="11" as="geometry"/></mxCell><mxCell id="c80" value="Legend" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1136" width="80" height="22" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;arcSize=20;fillColor=#DCE9F8;strokeColor=#2F5F9E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="1138" width="20" height="18" as="geometry"/></mxCell><mxCell id="c82" value="Software model" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="188" y="1137" width="260" height="21" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;arcSize=20;fillColor=#DDF1E4;strokeColor=#2E7D4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1138" width="20" height="18" as="geometry"/></mxCell><mxCell id="c84" value="Simulation and FPGA tool reports" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="508" y="1137" width="260" height="21" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;arcSize=20;fillColor=#FBEAD0;strokeColor=#B26A00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="1138" width="20" height="18" as="geometry"/></mxCell><mxCell id="c86" value="Hardware on the board" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="828" y="1137" width="260" height="21" as="geometry"/></mxCell><mxCell id="c87" value="A rung is passed only when a reviewer other than the author ticks every box. Hardware is correct when it produces exactly the same integers as ref_int.py." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="80" y="1167" width="940" height="21" as="geometry"/></mxCell><mxCell id="c88" value="Design: 16x16 bit-serial weight-stationary CIM tile (8 cycles per dot product, no DSP in the tile array). Stage 1 checks layer 1 on the Nexys A7-100T; later steps extend them to the full model." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="80" y="1190" width="940" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>