<mxfile host="app.diagrams.net"><diagram name="Verification ladder" id="vladder"><mxGraphModel dx="1100" dy="1242" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1242" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Verification ladder" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=26;fontColor=#1A1A1A;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="12" width="1100" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Float model → integer reference → Python tile model → RTL simulation → post-synthesis → post-implementation → board" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="0" y="52" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="Climb from the bottom. Each rung shows what is compared and its pass criteria. Source: CIM FYP Runbook, Step 1.2 (2023-FYDP-25)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;fontFamily=Helvetica;strokeColor=none;fillColor=none;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="0" y="79" width="1100" height="21" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=50;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="112" width="8" height="1008" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=50;fillColor=#6B6B6B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="112" width="8" height="1008" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=8;fillColor=#DCE9F8;strokeColor=#2F5F9E;strokeWidth=2.5;" vertex="1" parent="1">